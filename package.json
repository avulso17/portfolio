    "mini-svg-data-uri": "^1.4.4",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^3.2.0",
    "sharp": "^0.33.4",
    "tailwind-merge": "^1.14.0",
    "tailwind-variants": "^0.1.13",
    "uuid": "^9.0.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20",
